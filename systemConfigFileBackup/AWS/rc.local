#!/bin/sh
#
# This script will be executed *after* all the other init scripts.
# You can put your own initialization stuff in here if you don't
# want to do the full Sys V style init stuff

#redirect rc.local log to rc.local.log file
exec 1>/tmp/rc.local.log 2>&1
set -x

whoami

echo "Start up AEM">  /home/ec2-user/serverstart.log
cd /var/www/html/scripts/apps
./aem_start_script.sh

echo "TTT">  /home/ec2-user/serverstart.log
cd /var/www/html/works/Try-The-Tech/TTT-Map
npm install
npm run build
cd /var/www/html/works/Try-The-Tech/TTT-iphonex
npm install
npm run build

echo "Start up UserPoint">  /home/ec2-user/serverstart.log
cd /var/www/html/works/userPoints
npm install
npm run build

echo "Start up Litemall Service">>  /home/ec2-user/serverstart.log
sleep 3m
cd /var/www/html/litemall/litemall-admin
npm install
npm run build:dep
cd ..
mvn install
mvn clean package
cp -f ./litemall-all/target/litemall-all-*-exec.jar ./deploy/litemall/litemall.jar
/var/www/html/litemall/deploy/litemall/litemall.jar start
