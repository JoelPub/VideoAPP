<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="cq:Dialog"
    height="420"
    title="AMP  img"
    width="700"
    xtype="dialog">
    <items
        jcr:primaryType="cq:Widget"
        xtype="tabpanel">
        <items jcr:primaryType="cq:WidgetCollection">
            <tab1
                jcr:primaryType="cq:Panel"
                title="Tab 1">
                <items jcr:primaryType="cq:WidgetCollection">
                    <imgclass
                        jcr:primaryType="cq:Widget"
                        allowBlank="true"
                        fieldLabel="imgclass"
                        name="./imgclass"
                        xtype="textfield"/>
                    <banner
                        jcr:primaryType="cq:Widget"
                        fieldLabel="isbanner"
                        name="./isbanner"
                        xtype="checkbox"/>
                    <imgpath
                        jcr:primaryType="cq:Widget"
                        allowBlank="true"
                        fieldLabel="imgpath"
                        name="./imgpath"
                        xtype="pathfield"/>
                    <desc1
                        jcr:primaryType="cq:Widget"
                        allowBlank="true"
                        fieldLabel="Image URL"
                        name="./description1"
                        xtype="richtext"/>
                    <desc2
                        jcr:primaryType="cq:Widget"
                        allowBlank="true"
                        fieldLabel="Title"
                        name="./description2"
                        xtype="richtext"/>
                </items>
            </tab1>
        </items>
    </items>
</jcr:root>
