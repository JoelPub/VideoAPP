<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="cq:Widget"
    title="AMP Page Configuration"
    xtype="panel">
    <items jcr:primaryType="cq:WidgetCollection">
        <ampconfiguration
            jcr:primaryType="cq:Widget"
            collapsed="{Boolean}false"
            collapsible="{Boolean}true"
            title="Configuration"
            xtype="dialogfieldset">
            <items jcr:primaryType="cq:WidgetCollection">
                <canonical
                    jcr:primaryType="cq:Widget"
                    fieldLabel="Canonical"
                    hideLabel="false"
                    name="./canonical"
                    xtype="pathfield"/>
                <meta
                    jcr:primaryType="cq:Widget"
                    fieldLabel="Meta Tags"
                    height="200"
                    hideLabel="false"
                    name="./headmeta"
                    xtype="textarea"/>
                <headscript
                    jcr:primaryType="cq:Widget"
                    fieldLabel="Head Script"
                    height="200"
                    hideLabel="false"
                    name="./headScript"
                    xtype="textarea"/>
                <style
                    jcr:primaryType="cq:Widget"
                    fieldLabel="Style"
                    height="200"
                    hideLabel="false"
                    name="./ampstyle"
                    xtype="textarea"/>
                <logimage
                    jcr:primaryType="cq:Widget"
                    fieldLabel="Logo Image"
                    hideLabel="false"
                    name="./logimg"
                    xtype="pathfield"/>
                <logurl
                    jcr:primaryType="cq:Widget"
                    fieldLabel="Logo URL"
                    hideLabel="false"
                    name="./logurl"
                    xtype="pathfield"/>
                <navigation
                    jcr:primaryType="cq:Widget"
                    fieldLabel="Navigation"
                    height="200"
                    hideLabel="false"
                    name="./navScript"
                    xtype="textarea"/>
                <footer
                    jcr:primaryType="cq:Widget"
                    fieldLabel="Footer"
                    height="200"
                    hideLabel="false"
                    name="./footerScript"
                    xtype="textarea"/>
                <analyticsscript
                    jcr:primaryType="cq:Widget"
                    fieldLabel="Analytics Script"
                    height="200"
                    hideLabel="false"
                    name="./analyticsScript"
                    xtype="textarea"/>
            </items>
        </ampconfiguration>
    </items>
</jcr:root>
