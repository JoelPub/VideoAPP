<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="cq:Dialog"
    height="420"
    title="Electric Vehicle Map"
    width="700"
    xtype="dialog">
    <items jcr:primaryType="cq:WidgetCollection">
        <tab1
            jcr:primaryType="cq:Panel"
            title="Tab 1">
            <items jcr:primaryType="cq:WidgetCollection">
                <baiduId
                                jcr:primaryType="cq:Widget"
                                fieldLabel="baiduId"
                                name="./baiduId"
                                xtype="textfield"/>
                        <startImage
                            jcr:primaryType="cq:Widget"
                            allowBlank="false"
                            fieldLabel="Start Image Path"
                            name="./startImage"
                            parBrowse="false"
                            xtype="pathfield"/>
                        <destinyImage
                            jcr:primaryType="cq:Widget"
                            allowBlank="false"
                            fieldLabel="Destiny Image Path"
                            name="./destinyImage"
                            parBrowse="false"
                            xtype="pathfield"/>
                        <stationImage
                                jcr:primaryType="cq:Widget"
                                allowBlank="false"
                                fieldLabel="Station Image Path"
                                name="./stationImage"
                                parBrowse="false"
                                xtype="pathfield"/>
                        <arrowImage
                                jcr:primaryType="cq:Widget"
                                allowBlank="false"
                                fieldLabel="Arrow Image Path"
                                name="./arrowImage"
                                parBrowse="false"
                                xtype="pathfield"/>
                        <startCord
                            jcr:primaryType="cq:Widget"
                            fieldLabel="startCord"
                            name="./startCord"
                            xtype="textfield"/>
                        <daoLabel
                            jcr:primaryType="cq:Widget"
                            fieldLabel="daoLabel"
                            name="./daoLabel"
                            xtype="textfield"/>
                        <stationName
                            jcr:primaryType="cq:Widget"
                            fieldLabel="stationName"
                            name="./stationName"
                            xtype="textfield"/>
                        <miLabel
                            jcr:primaryType="cq:Widget"
                            fieldLabel="miLabel"
                            name="./miLabel"
                            xtype="textfield"/>
                        <stationLabel
                            jcr:primaryType="cq:Widget"
                            fieldLabel="stationLabel"
                            name="./stationLabel"
                            xtype="textfield"/>
                        <stationTimeLabel
                            jcr:primaryType="cq:Widget"
                            fieldLabel="stationTimeLabel"
                            name="./stationTimeLabel"
                            xtype="textfield"/>
                        <kmLabel
                            jcr:primaryType="cq:Widget"
                            fieldLabel="kmLabel"
                            name="./kmLabel"
                            xtype="textfield"/>
            </items>
        </tab1>
    </items>
</jcr:root>

