<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"   
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd"> 
<mapper namespace="com.shj.code.mapper.CategoryInfoMapper">
	<select id="getList" resultType="com.shj.code.entity.CategoryInfo">
	    select * from category_info where typeName=#{typeName,jdbcType=VARCHAR} order by id asc
	</select>
</mapper>
